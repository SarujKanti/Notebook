<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navFooter"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="12dp">

    <!-- Brand -->
    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_brand_feather"
        android:importantForAccessibility="no"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/app_name"
        android:textColor="?attr/colorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="44dp"
            android:layout_height="1dp"
            android:background="?attr/colorPrimary"
            android:alpha="0.45"/>

        <TextView
            android:id="@+id/tvNavVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"/>

        <View
            android:layout_width="44dp"
            android:layout_height="1dp"
            android:background="?attr/colorPrimary"
            android:alpha="0.45"/>
    </LinearLayout>

    <!-- Logout (Login for guests) -->
    <LinearLayout
        android:id="@+id/btnNavAuth"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_drawer_logout"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/ivNavAuth"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"/>

        <TextView
            android:id="@+id/tvNavAuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/drawer_logout_text"/>
    </LinearLayout>

</LinearLayout>
