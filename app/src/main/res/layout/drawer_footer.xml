<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navFooter"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="@dimen/dp_6"
    android:paddingBottom="@dimen/dp_14">

    <!-- Brand: "Note" in the text color, "Stack" in purple (set in code) -->
    <ImageView
        android:layout_width="@dimen/dp_34"
        android:layout_height="@dimen/dp_34"
        android:src="@drawable/ic_brand_feather"
        android:importantForAccessibility="no"/>

    <TextView
        android:id="@+id/tvNavBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:text="@string/app_name"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/text_headline"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_1"
            android:background="?attr/colorOnSurface"
            android:alpha="0.25"/>

        <TextView
            android:id="@+id/tvNavVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body"/>

        <View
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_1"
            android:background="?attr/colorOnSurface"
            android:alpha="0.25"/>
    </LinearLayout>

    <!-- Logout (Login for guests): an outlined pill -->
    <LinearLayout
        android:id="@+id/btnNavAuth"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginStart="@dimen/dp_22"
        android:layout_marginEnd="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_22"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_drawer_logout"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/ivNavAuth"
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:importantForAccessibility="no"/>

        <TextView
            android:id="@+id/tvNavAuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            android:textColor="@color/drawer_logout_text"/>
    </LinearLayout>

</LinearLayout>
