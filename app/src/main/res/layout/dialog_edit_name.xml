<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_sheet">

    <!-- Drag handle -->
    <View
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_4"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_12"
        android:background="#66FFFFFF"/>

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_16"
        android:paddingTop="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_8">

        <!-- Title, with a line saying what this is for -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_profile"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="@string/edit_profile_subtitle"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditNameClose"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:padding="@dimen/dp_10"
            android:src="@drawable/ic_close"
            android:tint="?attr/colorOnSurface"
            android:background="@drawable/bg_glass_circle"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"/>

    </LinearLayout>

    <!-- Profile picture: tap it (or "Change photo") to pick one from the device -->
    <FrameLayout
        android:id="@+id/avatarBlock"
        android:layout_width="@dimen/dp_104"
        android:layout_height="@dimen/dp_104"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_20"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/profile_picture">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivEditAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/dp_3"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_drawer_avatar"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.NoteBook.Circle"/>

        <TextView
            android:id="@+id/tvEditAvatarInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_hero"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <FrameLayout
            android:layout_width="@dimen/dp_34"
            android:layout_height="@dimen/dp_34"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_glass_primary">

            <ImageView
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_18"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/btnChangePhoto"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:gravity="center"
            android:paddingStart="@dimen/dp_14"
            android:paddingEnd="@dimen/dp_14"
            android:text="@string/change_photo"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:textColor="#CDBBFF"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnRemovePhoto"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:gravity="center"
            android:paddingStart="@dimen/dp_14"
            android:paddingEnd="@dimen/dp_14"
            android:text="@string/remove"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:textColor="#FF9A93"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Name field (Material OutlinedBox) -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginBottom="@dimen/dp_8"
        android:hint="@string/your_name"
        app:boxCornerRadiusTopStart="@dimen/dp_12"
        app:boxCornerRadiusTopEnd="@dimen/dp_12"
        app:boxCornerRadiusBottomStart="@dimen/dp_12"
        app:boxCornerRadiusBottomEnd="@dimen/dp_12">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:textSize="@dimen/text_subtitle"
            android:textColor="#FFFFFF"
            android:textColorHint="#CDBBFF"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingStart="@dimen/dp_20"
        android:paddingEnd="@dimen/dp_20"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_24">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditNameCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_8"
            android:text="@string/cancel"
            android:textColor="?attr/colorOnSurfaceVariant"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditNameSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            app:backgroundTint="@null"
            android:background="@drawable/bg_glass_primary"
            android:textColor="@color/colorOnPrimary"
            app:cornerRadius="@dimen/dp_24"
            android:minHeight="@dimen/dp_52"
            android:minWidth="@dimen/dp_110"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

    </LinearLayout>

</LinearLayout>
