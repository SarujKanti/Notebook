<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogFolderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_sheet">

    <!-- Drag handle -->
    <View
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_4"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_12"
        android:background="#66FFFFFF"/>

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_20"
        android:paddingEnd="@dimen/dp_8"
        android:paddingTop="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_10">

        <TextView
            android:id="@+id/tvFolderDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/new_folder_title"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"/>

        <ImageButton
            android:id="@+id/btnFolderClose"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:src="@drawable/ic_close"
            android:tint="?attr/colorOnSurfaceVariant"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"/>

    </LinearLayout>

    <!-- Thin divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.4"/>

    <!-- Name field (Material OutlinedBox) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFolderName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_20"
        android:hint="@string/folder_name"
        app:boxCornerRadiusTopStart="@dimen/dp_12"
        app:boxCornerRadiusTopEnd="@dimen/dp_12"
        app:boxCornerRadiusBottomStart="@dimen/dp_12"
        app:boxCornerRadiusBottomEnd="@dimen/dp_12">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFolderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:textSize="@dimen/text_subtitle"
            android:textColor="#FFFFFF"
            android:textColorHint="#CDBBFF"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Color section label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/folder_colour_label"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:letterSpacing="0.10"
        android:paddingStart="@dimen/dp_20"
        android:paddingTop="@dimen/dp_22"
        android:paddingBottom="@dimen/dp_10"/>

    <!-- Colour swatches -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_4"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/folderColorPickerRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"/>

    </HorizontalScrollView>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingStart="@dimen/dp_20"
        android:paddingEnd="@dimen/dp_20"
        android:paddingTop="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_24">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFolderCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_8"
            android:text="@string/cancel"
            android:textColor="?attr/colorOnSurfaceVariant"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFolderSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            app:backgroundTint="@null"
            android:background="@drawable/bg_glass_primary"
            android:textColor="@color/colorOnPrimary"
            app:cornerRadius="@dimen/dp_24"
            android:minHeight="@dimen/dp_52"
            android:minWidth="@dimen/dp_110"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

    </LinearLayout>

</LinearLayout>
