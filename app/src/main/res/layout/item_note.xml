<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNote"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_6"
    app:cardElevation="@dimen/dp_3"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Faint waves along the bottom edge. They clip themselves to the card's bottom corners: the card stops
             clipping its contents once a pinned note gets its cut corner, and the square wave poked out. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_84"
            android:layout_gravity="bottom"
            android:scaleType="fitXY"
            android:src="@drawable/bg_card_wave"
            android:importantForAccessibility="no"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.NoteBook.CardBottom"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_16">

            <!-- Shimmers in the photo's place while it loads -->
            <com.skd.notebook.ui.SkeletonBlock
                android:id="@+id/skNotePhoto"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_120"
                android:layout_marginBottom="@dimen/dp_10"
                android:visibility="gone"
                app:skeletonRadius="@dimen/dp_12"/>

            <!-- First photo attached to the note (shown once it is ready) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgNotePhoto"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_120"
                android:layout_marginBottom="@dimen/dp_10"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:importantForAccessibility="no"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.NoteBook.Thumb"/>

            <!-- Title -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="@dimen/text_subtitle"
                android:textColor="?attr/colorOnSurface"
                android:paddingEnd="@dimen/dp_46"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.1"/>

            <!-- Description -->
            <TextView
                android:id="@+id/txtDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="@dimen/dp_6"
                android:maxLines="6"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_12"
                android:background="?attr/colorOutline"
                android:alpha="0.28"/>

            <!-- The folder this note lives in (if any): its own line so a long name never squeezes the date -->
            <TextView
                android:id="@+id/txtFolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:maxLines="1"
                android:ellipsize="end"
                android:drawablePadding="@dimen/dp_5"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/dp_8"
                android:paddingEnd="@dimen/dp_10"
                android:paddingTop="@dimen/dp_3"
                android:paddingBottom="@dimen/dp_3"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"/>

            <!-- Footer: calendar + date on the left, "more" on the right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/ic_calendar"
                    android:alpha="0.8"
                    android:importantForAccessibility="no"
                    app:tint="?attr/colorOnSurface"/>

                <TextView
                    android:id="@+id/txtTimestamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_8"
                    android:maxLines="1"
                    android:textSize="@dimen/text_caption"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.8"/>

                <ImageButton
                    android:id="@+id/btnMore"
                    android:layout_width="@dimen/dp_34"
                    android:layout_height="@dimen/dp_34"
                    android:padding="@dimen/dp_6"
                    android:src="@drawable/ic_more_horiz"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/more_actions"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurface"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Folded top-right corner; only shown for pinned notes -->
        <ImageView
            android:id="@+id/pinFold"
            android:layout_width="@dimen/dp_18"
            android:layout_height="@dimen/dp_18"
            android:layout_gravity="top|end"
            android:src="@drawable/bg_pin_fold"
            android:importantForAccessibility="no"
            android:visibility="gone"/>

        <!-- Pin: the clip sits on a small white circle -->
        <ImageButton
            android:id="@+id/btnPin"
            android:layout_width="@dimen/dp_34"
            android:layout_height="@dimen/dp_34"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_10"
            android:padding="@dimen/dp_7"
            android:src="@drawable/ic_pin"
            android:background="@drawable/bg_pin_circle"
            android:contentDescription="@string/pin_note"/>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
