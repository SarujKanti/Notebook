<?xml version="1.0" encoding="utf-8"?>
<!-- The sunset picture and the wavy bottom edge behind this are drawn by DrawerPanelLayout. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/dp_22"
    android:paddingEnd="@dimen/dp_20"
    android:paddingTop="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_34">

    <!-- Avatar (tap to edit the name) -->
    <FrameLayout
        android:layout_width="@dimen/dp_76"
        android:layout_height="@dimen/dp_76"
        android:background="@drawable/bg_drawer_avatar">

        <!-- The user's own photo, when they set one; the initial below is shown otherwise -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivNavAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/dp_3"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.NoteBook.Circle"/>

        <TextView
            android:id="@+id/tvNavInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/initial_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_hero"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>
    </FrameLayout>

    <!-- Name and its edit pencil, then the email -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvNavName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_200"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/text_headline"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:text="@string/user_placeholder"/>

        <ImageView
            android:id="@+id/ivNavEditPencil"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:layout_marginStart="@dimen/dp_12"
            android:src="@drawable/ic_edit"
            android:importantForAccessibility="no"
            app:tint="#FFFFFF"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvNavEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:maxWidth="@dimen/dp_250"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/text_body"
        android:textColor="#E0D8FF"/>

</LinearLayout>
