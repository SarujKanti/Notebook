<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorAppBar"
        app:liftOnScroll="false"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:theme="@style/ThemeOverlay.NoteBook.Toolbar"
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorAppBar"
            app:navigationIcon="@drawable/ic_arrow_back_white"
            app:titleTextColor="@color/colorOnPrimary"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── 1. Theme ─────────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="10dp"
                            android:src="@drawable/ic_theme"
                            android:background="@drawable/bg_feature_icon"
                            android:importantForAccessibility="no"
                            app:tint="?attr/colorPrimary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Theme"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Pick how NoteStack looks, or follow your phone."
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"/>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnThemeLight"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="Light"
                            android:textAllCaps="false"
                            android:maxLines="1"
                            android:textSize="14sp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnThemeDark"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="Dark"
                            android:textAllCaps="false"
                            android:maxLines="1"
                            android:textSize="14sp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnThemeSystem"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1.4"
                            android:text="System default"
                            android:textAllCaps="false"
                            android:maxLines="1"
                            android:textSize="14sp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── 2. Font size ─────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="Aa"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:background="@drawable/bg_feature_icon"
                            android:importantForAccessibility="no"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Font Size"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Make text smaller or larger across the whole app."
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"/>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleFont"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFontSmall"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="Small"
                            android:textAllCaps="false"
                            android:maxLines="1"
                            android:textSize="14sp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFontMedium"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="Medium"
                            android:textAllCaps="false"
                            android:maxLines="1"
                            android:textSize="14sp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFontLarge"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="Large"
                            android:textAllCaps="false"
                            android:maxLines="1"
                            android:textSize="14sp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- Preview uses the same sizes as a note card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/bg_feature_icon">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Preview"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="This is how the text in your notes will look."
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.3"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
