<?xml version="1.0" encoding="utf-8"?>
<!-- Glass dialog. The outer padding leaves room around the panel because the dialog window itself is transparent. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dp_14">

    <LinearLayout
        android:id="@+id/dialogPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_22"
        android:background="@drawable/bg_glass_panel">

        <!-- Title + subtitle on the left, round icon on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_12"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialogTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="@dimen/text_headline"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/dialogSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="#DCD3F7"
                    android:visibility="gone"/>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/dialogBadge"
                android:layout_width="@dimen/dp_62"
                android:layout_height="@dimen/dp_62"
                android:background="@drawable/bg_glass_circle">

                <ImageView
                    android:id="@+id/dialogIcon"
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/dialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            android:textSize="@dimen/text_subtitle"
            android:lineSpacingMultiplier="1.25"
            android:textColor="#E9E4FA"
            android:visibility="gone"/>

        <FrameLayout
            android:id="@+id/dialogContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/dialogButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialogNegative"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_56"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_8"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_glass_button"
                android:foreground="?attr/selectableItemBackground"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/dialogPositive"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_56"
                android:layout_weight="1.25"
                android:layout_marginStart="@dimen/dp_8"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_glass_primary"
                android:foreground="?attr/selectableItemBackground"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
