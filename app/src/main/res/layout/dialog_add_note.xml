<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:minHeight="@dimen/dp_600">

    <!-- ── Top bar: the theme's surface color with round tonal buttons ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_68"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        android:background="@drawable/bg_editor_toolbar"
        android:elevation="@dimen/dp_6">

        <!-- Back -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:padding="@dimen/dp_10"
            android:src="@drawable/ic_arrow_back_rounded"
            app:tint="?attr/colorPrimary"
            android:background="@drawable/bg_editor_icon"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"/>

        <!-- Title and a hint of what the menu can do -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_14"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_note"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editor_subtitle"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Menu: voice typing, a photo from the gallery, or a photo from the camera -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:padding="@dimen/dp_10"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorPrimary"
            android:background="@drawable/bg_editor_icon"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_options"/>

    </LinearLayout>

    <!-- ── Title and note: one page that scrolls together, with photos placed between the text ── -->
    <ScrollView
        android:id="@+id/noteScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_title"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:background="@android:color/transparent"
                android:paddingStart="@dimen/dp_20"
                android:paddingEnd="@dimen/dp_20"
                android:paddingTop="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_8"
                android:inputType="textCapSentences"
                android:imeOptions="actionNext"/>

            <!-- The note's text blocks and photos are added here by NoteBody -->
            <LinearLayout
                android:id="@+id/bodyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </ScrollView>

    <!-- ── Bottom toolbar: colors ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Divider above bottom bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.4"/>

        <!-- Color label + picker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_12"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color_name"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:alpha="0.7"
                android:layout_marginEnd="@dimen/dp_8"/>

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/colorPickerRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"/>

            </HorizontalScrollView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
