<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/cardview_light_background">

    <!-- ── Hero section (gradient) ──────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_splash">

        <!-- Skip → continue without signing in (local-only mode) -->
        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/dp_36"
            android:layout_marginEnd="@dimen/dp_12"
            android:text="@string/skip"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:alpha="0.85"
            android:padding="@dimen/dp_12"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="@dimen/dp_40">

            <!-- Logo ring -->
            <FrameLayout
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_100"
                android:layout_gravity="center_horizontal">

                <View
                    android:layout_width="@dimen/dp_100"
                    android:layout_height="@dimen/dp_100"
                    android:background="@drawable/bg_icon_splash"/>

                <ImageView
                    android:layout_width="@dimen/dp_52"
                    android:layout_height="@dimen/dp_52"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_logo"
                    android:contentDescription="@string/app_name"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_hero"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="@dimen/dp_20"
                android:letterSpacing="0.04"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="#B8A8FF"
                android:textSize="@dimen/text_subtitle"
                android:layout_marginTop="@dimen/dp_6"/>

        </LinearLayout>

    </FrameLayout>

    <!-- ── Sign-in card ──────────────────────────────────────────────────── -->
    <androidx.cardview.widget.CardView
        xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        card_view:cardElevation="@dimen/dp_12"
        card_view:cardCornerRadius="0dp"
        card_view:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_28"
            android:paddingBottom="@dimen/dp_40">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_subtitle"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="@dimen/dp_4"/>

            <!-- Error message -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B00020"
                android:textSize="@dimen/text_body"
                android:gravity="center"
                android:layout_marginTop="@dimen/dp_12"
                android:visibility="gone"/>

            <!-- Progress -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_16"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone"/>

            <!-- Google Sign-In button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleSignIn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/continue_with_google"
                android:textSize="@dimen/text_subtitle"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnSurface"
                app:icon="@drawable/ic_google"
                app:iconSize="@dimen/dp_22"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/dp_12"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="@dimen/dp_1"
                app:cornerRadius="@dimen/dp_12"/>

            <!-- Privacy note -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/login_terms"
                android:textSize="@dimen/text_caption"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:alpha="0.6"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
