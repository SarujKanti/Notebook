<?xml version="1.0" encoding="utf-8"?>
<!-- The menu on the note editor's top-right button: three rows, each an icon tile with a title and a hint -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="@dimen/dp_12"
    android:paddingTop="@dimen/dp_8"
    android:paddingBottom="@dimen/dp_8"
    android:minWidth="@dimen/dp_260"
    android:elevation="@dimen/dp_12"
    android:background="@drawable/bg_glass_popup">

    <!-- Voice typing -->
    <LinearLayout
        android:id="@+id/menuVoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_14"
        android:paddingEnd="@dimen/dp_18"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="@dimen/dp_42"
            android:layout_height="@dimen/dp_42"
            android:background="@drawable/bg_glass_tile">

            <ImageView
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_22"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                android:importantForAccessibility="no"
                app:tint="#FFFFFF"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_voice_typing"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_voice_hint"
                android:textSize="@dimen/text_caption"
                android:textColor="#DCD3F7"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_70"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="#FFFFFF"
        android:alpha="0.16"/>

    <!-- Photo from the gallery -->
    <LinearLayout
        android:id="@+id/menuGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_14"
        android:paddingEnd="@dimen/dp_18"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="@dimen/dp_42"
            android:layout_height="@dimen/dp_42"
            android:background="@drawable/bg_glass_tile">

            <ImageView
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_22"
                android:layout_gravity="center"
                android:src="@drawable/ic_photo_library"
                android:importantForAccessibility="no"
                app:tint="#FFFFFF"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_choose_photo"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_gallery_hint"
                android:textSize="@dimen/text_caption"
                android:textColor="#DCD3F7"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_70"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="#FFFFFF"
        android:alpha="0.16"/>

    <!-- Photo from the camera -->
    <LinearLayout
        android:id="@+id/menuCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_14"
        android:paddingEnd="@dimen/dp_18"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="@dimen/dp_42"
            android:layout_height="@dimen/dp_42"
            android:background="@drawable/bg_glass_tile">

            <ImageView
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_22"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera"
                android:importantForAccessibility="no"
                app:tint="#FFFFFF"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_14"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_take_photo"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_camera_hint"
                android:textSize="@dimen/text_caption"
                android:textColor="#DCD3F7"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
