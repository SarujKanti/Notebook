<?xml version="1.0" encoding="utf-8"?>
<!-- One filter pill in the home header: icon, label and a count badge. Built four times in code. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chipRoot"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_marginEnd="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_chip_unselected"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/chipIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"/>

    <TextView
        android:id="@+id/chipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFF"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/chipCount"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginStart="8dp"
        android:minWidth="28dp"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_chip_badge"
        android:fontFamily="sans-serif-medium"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="13sp"/>
</LinearLayout>
