<?xml version="1.0" encoding="utf-8"?>
<!-- One filter pill in the home header: icon, label and a count badge. Built four times in code. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chipRoot"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dp_48"
    android:layout_marginEnd="@dimen/dp_10"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_8"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_chip_unselected"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/chipIcon"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:importantForAccessibility="no"/>

    <TextView
        android:id="@+id/chipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_subtitle"/>

    <TextView
        android:id="@+id/chipCount"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_26"
        android:layout_marginStart="@dimen/dp_8"
        android:minWidth="@dimen/dp_28"
        android:gravity="center"
        android:paddingStart="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_8"
        android:background="@drawable/bg_chip_badge"
        android:fontFamily="sans-serif-medium"
        android:text="@string/zero_placeholder"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_body"/>
</LinearLayout>
