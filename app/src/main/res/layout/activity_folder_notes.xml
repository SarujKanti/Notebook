<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorAppBar"
        app:liftOnScroll="false"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:theme="@style/ThemeOverlay.NoteBook.Toolbar"
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorAppBar"
            app:navigationIcon="@drawable/ic_arrow_back_white"
            app:titleTextColor="@color/colorOnPrimary"/>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ImageView
            android:layout_width="@dimen/dp_96"
            android:layout_height="@dimen/dp_96"
            android:src="@drawable/ic_notes_empty"
            android:alpha="0.25"
            android:contentDescription="@string/no_notes_icon"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_folder_notes_title"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.4"
            android:layout_marginTop="@dimen/dp_16"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_folder_notes_hint"
            android:textSize="@dimen/text_body"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/dp_6"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_20"
        android:paddingStart="@dimen/dp_4"
        android:paddingEnd="@dimen/dp_4"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="@dimen/dp_80"
        android:layout_marginEnd="@dimen/dp_16"
        android:text="@string/new_note_label"
        android:textColor="@color/colorOnAccent"
        android:textSize="@dimen/text_subtitle"
        android:textStyle="bold"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/colorOnAccent"
        app:backgroundTint="@color/colorAccent"
        app:elevation="@dimen/dp_6"
        app:cornerRadius="@dimen/dp_28"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
