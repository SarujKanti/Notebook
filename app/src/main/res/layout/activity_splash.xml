<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <!-- Center content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Logo: dark-navy rounded square + coloured folder icon -->
        <FrameLayout
            android:layout_width="@dimen/dp_140"
            android:layout_height="@dimen/dp_140"
            android:layout_gravity="center_horizontal">

            <!-- Dark-navy rounded tile (matches the icon's own background) -->
            <View
                android:layout_width="@dimen/dp_140"
                android:layout_height="@dimen/dp_140"
                android:background="@drawable/bg_icon_splash"/>

            <!-- Coloured folder icon — NO tint so the icon's own colours show -->
            <ImageView
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_100"
                android:layout_gravity="center"
                android:src="@drawable/ic_logo"
                android:contentDescription="@string/app_name"/>

        </FrameLayout>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_hero"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="@dimen/dp_28"
            android:letterSpacing="0.05"/>

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textColor="#B0A0FF"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginTop="@dimen/dp_8"
            android:letterSpacing="0.02"/>

    </LinearLayout>

    <!-- Loading: two shimmering bars in soft white on the dark screen -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/dp_64"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <com.skd.notebook.ui.SkeletonBlock
            android:layout_width="@dimen/dp_140"
            android:layout_height="@dimen/dp_8"
            app:skeletonRadius="@dimen/dp_4"
            app:skeletonColor="#26FFFFFF"
            app:skeletonHighlightColor="#80FFFFFF"/>

        <com.skd.notebook.ui.SkeletonBlock
            android:layout_width="@dimen/dp_88"
            android:layout_height="@dimen/dp_8"
            android:layout_marginTop="@dimen/dp_10"
            app:skeletonRadius="@dimen/dp_4"
            app:skeletonColor="#26FFFFFF"
            app:skeletonHighlightColor="#80FFFFFF"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom|center_horizontal"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/dp_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/powered_by"
            android:textSize="@dimen/text_body"
            android:textColor="@color/white"
            android:fontFamily="sans-serif"
            android:padding="@dimen/dp_4"/>

    </LinearLayout>

</RelativeLayout>
