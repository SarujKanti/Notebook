<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.NoteBook" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorAppBar</item>
        <!-- DrawerLayout paints its status-bar band with this, so it must match the app bar -->
        <item name="colorPrimaryDark">@color/colorAppBar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <!--
            Android 15 (API 35+) forces edge-to-edge for apps targeting >= 35.
            This opt-out restores the traditional behaviour where the system draws
            the status bar and nav bar OUTSIDE the app's content area.
            Without this, content overlaps the status bar on API 35+ devices.
        -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="Theme.NoteBook" parent="Base.Theme.NoteBook" />

    <style name="TextAppearance.NoteBook.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <!-- Toolbars sit on the purple app bar: overflow (three dots) and menu icons must be light -->
    <style name="ThemeOverlay.NoteBook.Toolbar" parent="">
        <item name="colorControlNormal">@color/colorOnPrimary</item>
    </style>

    <!-- Rounded MaterialAlertDialog used throughout the app -->
    <style name="MaterialAlertDialog_Rounded" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Dialog.Rounded</item>
    </style>

    <style name="ShapeAppearance.Dialog.Rounded" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Glass bottom sheets (action menu, folder editor, name editor): light text on a frosted panel -->
    <style name="ThemeOverlay.NoteBook.GlassSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#DCD3F7</item>
        <item name="colorOutline">#99FFFFFF</item>
        <item name="colorOutlineVariant">#33FFFFFF</item>
        <item name="colorPrimary">#CDBBFF</item>
        <item name="bottomSheetStyle">@style/Widget.NoteBook.GlassBottomSheet</item>
    </style>

    <style name="Widget.NoteBook.GlassBottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <!-- Fully round (a circle on a square view), for the New Note button -->
    <style name="ShapeAppearanceOverlay.NoteBook.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Rounded only at the bottom, matching a note card: clips the wave layer to the card's bottom corners -->
    <style name="ShapeAppearanceOverlay.NoteBook.CardBottom" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">@dimen/card_corner_radius</item>
        <item name="cornerSizeBottomRight">@dimen/card_corner_radius</item>
    </style>
</resources>
