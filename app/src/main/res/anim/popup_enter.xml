<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quad">
    <scale
        android:fromXScale="0.8"
        android:toXScale="1"
        android:fromYScale="0.8"
        android:toYScale="1"
        android:pivotX="100%"
        android:pivotY="0%"
        android:duration="170"/>
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="170"/>
</set>
