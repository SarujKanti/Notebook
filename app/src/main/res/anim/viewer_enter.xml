<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <scale
        android:fromXScale="0.7"
        android:toXScale="1"
        android:fromYScale="0.7"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="200"/>
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="200"/>
</set>
