<!--
    Folded-over flap of a pinned note. The card itself has its top-right corner cut off (see
    NoteAdapter), so only the flap is drawn here: the triangle on the card side of the cut.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="18dp"
    android:height="18dp"
    android:viewportWidth="18"
    android:viewportHeight="18">
    <path
        android:fillColor="@color/colorFoldFlap"
        android:pathData="M0,0 L0,18 L18,18 Z"/>
</vector>
