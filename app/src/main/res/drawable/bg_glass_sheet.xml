<?xml version="1.0" encoding="utf-8"?>
<!-- Same glass look as bg_glass_panel, but rounded only at the top, for bottom sheets. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#F04A3D96"
                android:endColor="#F0281F5E"/>
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#3AFFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#1AB9A0FF"/>
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="#66FFFFFF"/>
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp"/>
        </shape>
    </item>
</layer-list>
