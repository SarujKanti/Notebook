<!-- The main action: violet glass, brighter at the top where the light hits it -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F29A6EFF"
                android:endColor="#F25E2FD8"/>
            <corners android:radius="@dimen/dp_24"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF"/>
            <stroke android:width="@dimen/dp_1" android:color="#8CFFFFFF"/>
            <corners android:radius="@dimen/dp_24"/>
        </shape>
    </item>
</layer-list>
