<!-- A purple gradient ring: a gradient disc with a dark disc inside it -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#D2C2FF"
                android:endColor="#6E45E8"/>
        </shape>
    </item>
    <item
        android:left="@dimen/dp_3"
        android:top="@dimen/dp_3"
        android:right="@dimen/dp_3"
        android:bottom="@dimen/dp_3">
        <shape android:shape="oval">
            <solid android:color="#2B2060"/>
        </shape>
    </item>
</layer-list>
